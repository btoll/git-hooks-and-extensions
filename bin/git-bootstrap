#!/bin/bash

# Will copy every file from $HOME/.local/share/git-hooks-and-extensions/bootstrap/ into either the cwd
# or, if given, the location pointed to be `--dir`.
# Files copied will be `LICENSE`, `README.md`, et al.
#
# Also, will update the project name in README.md to $(basename $PROJECT_DIR)."

set -eo pipefail

PROJECT_DIR=

usage() {
    printf "git-bootstrap

Usage: %s [args]

Args:
--dir, -d   The git directory into which the files will be copied.
--help      Help.

Truthfully, this doesn't use any \`git\` commands.  Oh well.\n" "$0"
}

if [ "$#" -gt 0 ]; then
    while [ "$#" -gt 0 ]; do
        OPT="$1"
        case "$OPT" in
            --dir|-d) shift; PROJECT_DIR="$1" ;;
            --help) usage; exit 0 ;;
            *) printf "%b Unknown option.\n" "$ERROR"; usage; exit 1 ;;
        esac
        shift
    done
fi

if [ -z "$PROJECT_DIR" ]
then
    PROJECT_DIR=$(pwd)
fi

# Toggle to include hidden files in the filename expansion when globbing.
shopt -s dotglob
for file in "$HOME/.local/share/git-hooks-and-extensions/bootstrap/"*
do
    cp -i "$file" "$PROJECT_DIR"
    # This is matching against the absolute file name.
    if [ "$(basename "$file")" = .gitignore ]
    then
        sed -i 's/PROJECT_NAME/'"$(basename "$PROJECT_DIR")"'/' "$PROJECT_DIR/$(basename "$file")"
    fi

    if [ "$(basename "$file")" = README.md ]
    then
        sed -i -e 's/PROJECT_NAME/'"$(basename "$PROJECT_DIR")"'/' \
	    -e 's/PROJECT_AUTHOR/'"$(git config get user.name)"'/' \
	    -e 's|PROJECT_SITE|'"$(git config get user.site)"'|' "$PROJECT_DIR/README.md"
    fi
done
shopt -u dotglob

printf "%b Installed bootstrap files into %s.\n" "$SUCCESS" "$PROJECT_DIR"

